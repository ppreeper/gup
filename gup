# :command.inspect_args
_inspect_sort() {
  sort -t "$(printf '\t')" -k1,1
}

_inspect_args_section() {
  _is_head=""
  while IFS="$(printf '\t')" read -r _is_k _is_v; do
    if [ -z "$_is_head" ]; then
      printf '%s\n' "args:"
      _is_head=1
    fi
    printf -- '- ${args[%s]} = %s\n' "$_is_k" "$_is_v"
  done
  if [ -z "$_is_head" ]; then
    printf '%s\n' "args: none"
  fi
}

_inspect_deps_section() {
  _id_head=""
  while IFS="$(printf '\t')" read -r _id_k _id_v; do
    if [ -z "$_id_head" ]; then
      printf '%s\n' "" "deps:"
      _id_head=1
    fi
    printf -- '- ${deps[%s]} = %s\n' "$_id_k" "$_id_v"
  done
}

_inspect_env_section() {
  [ "$#" -gt 0 ] || return 0
  printf '%s\n' "" "environment variables:"
  printf '%s\n' "$@" | sort | while IFS= read -r _ie_n; do
    _inspect_env_value "$_ie_n"
    printf -- '- $%s = %s\n' "$_ie_n" "$_ie_v"
  done
}

_inspect_env_value() {
  case "$1" in
    *) _ie_v="" ;;
  esac
}

_inspect_other_section() {
  printf '%s\n' "" "other_args:"
  printf -- '- ${other_args[*]} = %s\n' "$1"
  _io_i=0
  for _io_a in $1; do
    printf -- '- ${other_args[%s]} = %s\n' "$_io_i" "$_io_a"
    _io_i=$((_io_i + 1))
  done
}

