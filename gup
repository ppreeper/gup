# :command.initialize
initialize() {
  version="0.1.0"
  set -e
}


# :command.run
run() {
  long_usage=""
  normalize_input "$@"
  while [ $# -gt 0 ]; do
    case "$1" in
      --version) version_command; return 0 ;;
      -h|--help) long_usage=yes; gup_usage; return 0 ;;
      --) shift; break ;;
      -*) echo "invalid option: $1" >&2; exit 1 ;;
      *) break ;;
    esac
  done
  if [ $# -eq 0 ]; then
    gup_usage >&2
    exit 1
  fi
  _cmd="$1"; shift
  case "$_cmd" in
    install) install_command "$@" ;;
    remove) remove_command "$@" ;;
    *) echo "invalid command: $_cmd" >&2; exit 1 ;;
  esac
}


# :command.start
initialize
run "$@"

