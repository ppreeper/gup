# :command.function install_nerdfonts
install_nerdfonts_parse() {
  _options_ended=false
  _pos=0
  if [ "${1:-}" = "-h" ] || [ "${1:-}" = "--help" ]; then
    long_usage=yes
    gup_install_nerdfonts_usage
    exit 0
  fi
  while [ $# -gt 0 ]; do
    _parse_key="$1"
    if [ "$_options_ended" = true ]; then
      _parse_key=""
    fi
    case "$_parse_key" in
      -[a-zA-Z0-9][a-zA-Z0-9]*)
        _cluster="${1#-}"
        shift
        while [ -n "$_cluster" ]; do
          _c="${_cluster#"${_cluster%?}"}"
          _cluster="${_cluster%?}"
          set -- "-$_c" "$@"
        done
        continue ;;
      --) shift; _options_ended=true ;;
      -*) echo "invalid option: $1" >&2; exit 1 ;;
      *)
        _pos=$((_pos + 1))
        if [ "$_pos" -ge 1 ]; then font="${font} $1" ; fi
        shift ;;
    esac
  done
  if [ -n "${font+x}" ]; then font="${font# }"; fi
  if [ -z "${font+x}" ]; then
    echo "missing required argument: FONT" >&2
    echo "usage: gup install nerdfonts FONT..." >&2
    exit 1
  fi
  if [ -n "${font}" ]; then
    case "${font}" in
      Ubuntu|UbuntuMono|Hack|FiraMono|Noto) ;;
      *) echo "Error: <font> must be one of: Ubuntu, UbuntuMono, Hack, FiraMono, Noto" >&2; exit 1 ;;
    esac
  fi
}

install_nerdfonts_command() {
  _inspect_cmd=install_nerdfonts
  install_nerdfonts_parse "$@"
  set -eu

  REPO="ryanoasis/nerd-fonts"
  FONTDIR="${HOME}/.local/share/fonts"

  download() {
    echo "installing $1 font"
    dl_urls=$(printf '%s\n' "${GUP_REL_JSON}" | jq -r '.assets[] | select(.name | contains("tar.xz")) | .browser_download_url' | grep "$1")
    printf '%s\n' "${dl_urls}" | while IFS= read -r font; do
        [ -z "${font}" ] && continue
        tmp_dir=$(gup_mktemp_dir)

        gup_download "${font}" "${tmp_dir}/font.tar.xz"
        mkdir -p "${FONTDIR}"
        tar -xf "${tmp_dir}/font.tar.xz" -C "${FONTDIR}" --wildcards "*ttf"
        rm -rf "${tmp_dir}"
    done
  }

  gup_fetch_release "${REPO}" 'contains("tar.xz")'
  fonts="${font}"
  printf '%s\n' "${fonts}" | while IFS= read -r font; do
    [ -z "${font}" ] && continue
    download "$font"
  done
}

