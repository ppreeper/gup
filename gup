    sudo rm -rf "${IDIR}/zig"
    sudo mkdir -p "${IDIR}/zig"
    sudo tar axf "${tmp_dir}/${FN}" -C "${IDIR}/zig" --strip-components=1
    sudo ln -sf "${IDIR}/zig/zig" "${BDIR}/zig"
  }

  if [ -z "$(command -v "${APP}")" ]; then
    download new
  else
    APPVER=$($(command -v "${APP}") version 2>&1)
    if [ "${APPVER}" = "${vers}" ]; then
        echo "${APP} version is current"
    else
        download "${vers}"
    fi
