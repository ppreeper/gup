  _options_ended=false
  _pos=0
  if [ "${1:-}" = "-h" ] || [ "${1:-}" = "--help" ]; then
    long_usage=yes
    gup_install_sqlc_usage
    exit 0
  fi
  while [ $# -gt 0 ]; do
    _parse_key="$1"
    if [ "$_options_ended" = true ]; then
      _parse_key=""
    fi
    case "$_parse_key" in
      -[a-zA-Z0-9][a-zA-Z0-9]*)
        _cluster="${1#-}"
        shift
        while [ -n "$_cluster" ]; do
          _c="${_cluster#"${_cluster%?}"}"
          _cluster="${_cluster%?}"
          set -- "-$_c" "$@"
        done
        continue ;;
      --) shift; _options_ended=true ;;
      -*) echo "invalid option: $1" >&2; exit 1 ;;
      *) break ;;
    esac
  done
}

install_sqlc_command() {
  _inspect_cmd=install_sqlc
  install_sqlc_parse "$@"
  set -eu

  APP="sqlc"
  REPO="sqlc-dev/sqlc"
  vers=$(gup_get_latest_release "${REPO}")

  gup_ensure_go
  go install github.com/${REPO}/cmd/sqlc@"${vers}"
}

